  "max_persons": 12,
  "method": [
   {
    "steps": [
     "Tænd ovnen på 200 grader varmluft og sæt en bagerist i ovnen",
     "Pil rødløg, gem halvdelen til salaten og hak resten fint på et skærebræt",
     "Pil hvidløg og hak fint. Gem halvdelen af hvidløget til dressingen",
     "Skyl og hak persille fint (både blade og stilk). Gem halvdelen til salaten",
     "Kom kødet i en røreskål sammen med hakket løg, hvidløg og persille samt krydderimix, salt og peber. Rør det godt sammen til en fars",
     "Fordel farsen jævnt i et smurt ovnfast fad, så den dækker hele bunden i et lag på ca. 2 cm.",
     "Brug en kniv eller dejskraber til at trække aflange riller i farsen – det giver små “kebabstykker”, som bliver nemme at tage op, når retten er bagt. Lav f.eks. 1 lang strimmel pr. fladbrød",
     "Bag fadet i ovnen i ca. 15-20 min. og slut af med ca. 2-3 min. på grillfunktion, til kødet er gennemstegt og gyldent"
    ],
    "title": "Kebabfad"
   },
   {
    "steps": [
     "Snit resterende rødløg i tynde skiver",
     "Skyl tomat og skær i tern",
     "Skyl agurk og halver på langs. Skrab kerner ud og snit i skiver",
     "Skyl salat og skær i tynde strimler",
     "Vend rødløg, tomat, agurk, salat og hakket persille sammen i en salatskål. Dryp med lidt olivenolie og krydr let med salt og peber"
    ],
    "title": "Salat"
   },
   {
    "steps": [
     "Rør yoghurt sammen med det gemte hvidløg, sukker, salt og peber. Tilføj evt. også lidt af krydderiblandingen efter ønsket smag"
    ],
    "title": "Dressing"
   },
   {
    "steps": [
     "Lun fladbrød ca. 1-2 min. på bageristen i ovnen eller hurtigt på en brødrister/i mikroovnen, indtil de er bløde og lune",
     "Lad hver medspiser samle sit eget fladbrød med hvidløgsdressing, kebabkød og frisk salat"
    ],
    "title": "Servering"
   }
  ],
